# 이 파일을 .env.local 로 복사해서 값 채우기 (.env.local 은 커밋 안 됨)

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Upstage 콘솔 (https://console.upstage.ai)
UPSTAGE_API_KEY=

# (선택) Mathpix — 비워두면 Upstage 실패 시 바로 Claude 로 넘어감
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Claude Code 헤드리스 (API 키 아님. 이 컴퓨터에서 `claude` 로그인된 구독 사용)
# claude 가 PATH 에 없으면 전체 경로 지정 (예: /Users/you/.local/bin/claude)
CLAUDE_BIN=claude
# 비우면 Claude Code 기본 모델. sonnet 이 빠름
CLAUDE_MODEL=sonnet

# OCR 신뢰도가 이 값 미만이면 다음 엔진으로
OCR_MIN_CONFIDENCE=0.6
# 동시에 돌릴 분석 개수
ANALYSIS_CONCURRENCY=2
