# 복사해서 .env 로 만들고 값을 채우세요 (저장소 루트에 둠). .env 는 커밋되지 않습니다.
# 고친 뒤에는 npm run dev 를 껐다 켜야 반영됩니다.

# ── 필수 ──────────────────────────────────────────────

# 업스테이지 API 키 (OCR + 기본 풀이 분석 모델에 같이 사용)
UPSTAGE_API_KEY=

# DB: Supabase 프로젝트 → 상단 Connect → Session pooler 주소 (README '실행 방법' 참고)
# [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣는다 (대괄호도 지움). 이 주소는 단톡·채팅에 올리지 말 것
DATABASE_URL=postgresql://postgres.<프로젝트ID>:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# 앱은 위 주소의 5432(Session 모드, 연결 최대 15개)를 자동으로 6543(Transaction 모드)으로 바꿔 붙는다. 예전 방식: DB_POOLER=session

# ── 선택 (비워 두면 아래 기본값 사용) ──────────────────

# 풀이 분석 모델 (기본: 업스테이지 Solar Pro 4)
# 나중에 EXAONE 4.5 를 LM Studio / vLLM 으로 띄우면 아래 세 줄만 바꾸면 됨
# 예) LM Studio: ANALYSIS_BASE_URL=http://localhost:1234/v1  ANALYSIS_MODEL=exaone-4.5-33b  ANALYSIS_API_KEY=lm-studio
ANALYSIS_BASE_URL=https://api.upstage.ai/v1
ANALYSIS_MODEL=solar-pro4
# 비워 두면 UPSTAGE_API_KEY 를 사용
ANALYSIS_API_KEY=

# OCR 이 확신 없는 풀이 다시 읽기는 이 컴퓨터의 Claude Code(claude 명령, 구독)로 한다. API 키 필요 없음
# 먼저 터미널에서 claude 를 한 번 실행해 로그인해 두기. 없으면 다시 읽기를 건너뛰고 OCR 결과 그대로 (보정·채점은 위 Solar)
# VISION_MODEL=sonnet         OCR 이 확신 없는 풀이를 이미지로 다시 읽는 모델
# VISION=off                  다시 읽기 끄기
# CLAUDE_CLI=claude           claude 명령 경로

# 선생님 화면 실시간 새로고침 (Supabase Realtime, db/init/15_realtime.sql)
# Supabase 대시보드 → Project Settings → API 의 anon(public) 키. 비워 두면 예전처럼 4초마다 다시 불러옴
# 주소는 DATABASE_URL 의 프로젝트 ID 로 https://<프로젝트ID>.supabase.co 를 만든다 (못 찾을 때만 SUPABASE_URL)
SUPABASE_ANON_KEY=
# SUPABASE_URL=https://<프로젝트ID>.supabase.co

# OCR 주소 (보통 바꿀 일 없음)
# UPSTAGE_OCR_URL=https://api.upstage.ai/v1/document-digitization
