# 복사해서 .env 로 만들고 값을 채우세요 (저장소 루트에 둠). .env 는 커밋되지 않습니다.
# 고친 뒤에는 npm run dev 를 껐다 켜야 반영됩니다.

# ── 필수 ──────────────────────────────────────────────

# 업스테이지 API 키 (손글씨 OCR + 학생 요약·문항 생성 Solar 에 같이 사용)
UPSTAGE_API_KEY=

# DB: Supabase 프로젝트 → 상단 Connect → Session pooler 주소 (README '실행 방법' 참고)
# [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣는다 (대괄호도 지움). 이 주소는 단톡·채팅에 올리지 말 것
DATABASE_URL=postgresql://postgres.<프로젝트ID>:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── 선택 (비워 두면 아래 기본값 사용) ──────────────────

# 학생 요약·보충 문항·소단원 문항 생성 모델 (기본: 업스테이지 Solar Pro 4)
# (OCR 보정·풀이 분석은 아래 Claude 헤드리스가 함)
# 나중에 EXAONE 4.5 를 LM Studio / vLLM 으로 띄우면 아래 세 줄만 바꾸면 됨
# 예) LM Studio: ANALYSIS_BASE_URL=http://localhost:1234/v1  ANALYSIS_MODEL=exaone-4.5-33b  ANALYSIS_API_KEY=lm-studio
ANALYSIS_BASE_URL=https://api.upstage.ai/v1
ANALYSIS_MODEL=solar-pro4
# 비워 두면 UPSTAGE_API_KEY 를 사용
ANALYSIS_API_KEY=

# OCR 이 확신 없는 풀이 다시 읽기: Mathpix → (그래도 이상하면) Claude
# Mathpix 키는 선택. 비워 두면 바로 Claude 로 넘어감 (https://console.mathpix.com)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Claude Code 헤드리스 (OCR 다시 읽기·OCR 보정·풀이 분석)
#   API 키가 아니라 이 컴퓨터에서 `claude` 로 로그인한 구독을 쓴다 → 서버는 그 노트북에서 띄울 것
#   claude 가 PATH 에 없으면 전체 경로 (예: /Users/<이름>/.local/bin/claude)
CLAUDE_BIN=claude
# sonnet(빠름) / opus
CLAUDE_MODEL=sonnet
# 1 로 두면 Claude 단계 끔
# CLAUDE_DISABLED=
# 다시 읽는 방식: full(기본, 이미지 전체) / lines(확신 없는 줄만 잘라서)
# VISION_MODE=full

# OCR 주소 (보통 바꿀 일 없음)
# UPSTAGE_OCR_URL=https://api.upstage.ai/v1/document-digitization
